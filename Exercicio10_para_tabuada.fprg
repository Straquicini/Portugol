        <attribute name="saved" value="2024-09-30 03:37:47 "/>
        <attribute name="created" value="MTQ2NDI7QVVESU9WSVNVQUlTXzA4OzIwMjQtMDktMjc7IjEwOjAwOjAxICI7MjU1Nw=="/>
        <attribute name="edited" value="MTQ2NDI7QVVESU9WSVNVQUlTXzA4OzIwMjQtMDktMzA7IjAzOjM3OjQ3ICI7MTE7MjczMA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="passo, conta, num, aux, i" type="Integer" array="False" size=""/>
            <assign variable="conta" expression="0"/>
            <assign variable="passo" expression="0"/>
            <assign variable="aux" expression="10"/>
            <output expression="&quot;Diga um n&#250;mero para sua tabuada: &quot;" newline="True"/>
            <input variable="num"/>
            <for variable="i" start="1" end="10" direction="inc" step="1">
                <assign variable="conta" expression="conta + num"/>
                <assign variable="passo" expression="passo + 1"/>
                <output expression="num &amp; &quot; x &quot; &amp; passo  &amp; &quot; = &quot; &amp; conta" newline="True"/>
            </for>
            <output expression="&quot;A soma de &quot; &amp; passo &amp; &quot; x o n&#250;mero &quot; &amp; num &amp; &quot; = &quot; &amp; conta" newline="True"/>
        </body>
    </function>
</flowgorithm>
