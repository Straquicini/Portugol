    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="base, exp, i, resultado" type="Integer" array="False" size=""/>
            <assign variable="resultado" expression="1"/>
            <assign variable="base" expression="3"/>
            <assign variable="exp" expression="3"/>
            <for variable="i" start="exp" end="1" direction="inc" step="1">
                <assign variable="resultado" expression="base*resultado"/>
            </for>
            <output expression="&quot; O resultado de &quot; &amp; base &amp; &quot;^&quot; &amp; exp &amp; &quot; = &quot; &amp; resultado" newline="True"/>
        </body>
    </function>
</flowgorithm>
