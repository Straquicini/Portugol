<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="14642"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2024-09-30 03:56:43 "/>
        <attribute name="created" value="MTQ2NDI7QVVESU9WSVNVQUlTXzA4OzIwMjQtMDktMjc7IjEwOjAwOjAxICI7MjU1Nw=="/>
        <attribute name="edited" value="MTQ2NDI7QVVESU9WSVNVQUlTXzA4OzIwMjQtMDktMzA7IjAzOjU2OjQzICI7ODsyNjg1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="passo, conta, num, aux" type="Integer" array="False" size=""/>
            <assign variable="conta" expression="0"/>
            <assign variable="passo" expression="1"/>
            <assign variable="aux" expression="10"/>
            <output expression="&quot;Diga um n&#250;mero para sua tabuada: &quot;" newline="True"/>
            <input variable="num"/>
            <while expression="aux &gt; 0">
                <assign variable="aux" expression="aux - 1"/>
                <assign variable="conta" expression="conta + num"/>
                <output expression="num &amp; &quot; x &quot; &amp; passo  &amp; &quot; = &quot; &amp; conta" newline="True"/>
                <if expression="aux &gt; 0">
                    <then>
                        <assign variable="passo" expression="passo + 1"/>
                    </then>
                    <else/>
                </if>
            </while>
            <output expression="&quot;A soma de &quot; &amp; passo &amp; &quot; x o n&#250;mero &quot; &amp; num &amp; &quot; = &quot; &amp; conta" newline="True"/>
        </body>
    </function>
</flowgorithm>
